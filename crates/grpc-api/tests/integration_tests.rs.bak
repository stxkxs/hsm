use grpc_api::proto::hsm::hsm_client::HsmClient;
use grpc_api::proto::hsm::*;
use grpc_api::GrpcServer;
use hsm_auth::AuthManager;
use hsm_crypto_engine::CryptoEngine;
use hsm_key_manager::KeyManager;
use std::net::SocketAddr;
use std::sync::Arc;
use tokio::time::{sleep, Duration};
use tonic::transport::Channel;

async fn setup_test_server() -> SocketAddr {
    let addr: SocketAddr = "127.0.0.1:0".parse().unwrap();

    let key_manager = Arc::new(KeyManager::new().await.unwrap());
    let crypto_engine = Arc::new(CryptoEngine::new());
    let auth_manager = Arc::new(AuthManager::new());

    let listener = tokio::net::TcpListener::bind(addr).await.unwrap();
    let addr = listener.local_addr().unwrap();

    tokio::spawn(async move {
        let server = GrpcServer::new(addr, key_manager, crypto_engine, auth_manager);
        let _ = server.serve().await;
    });

    sleep(Duration::from_millis(100)).await;
    addr
}

async fn create_client(addr: SocketAddr) -> HsmClient<Channel> {
    let url = format!("http://{}", addr);
    HsmClient::connect(url).await.unwrap()
}

#[tokio::test]
async fn test_health_check() {
    let addr = setup_test_server().await;
    let mut client = create_client(addr).await;

    let request = tonic::Request::new(HealthCheckRequest {
        service: "hsm".to_string(),
    });

    let response = client.health_check(request).await;
    assert!(response.is_ok());

    let inner = response.unwrap().into_inner();
    assert_eq!(inner.status, health_check_response::ServingStatus::Serving as i32);
}

#[tokio::test]
async fn test_generate_key_without_auth() {
    let addr = setup_test_server().await;
    let mut client = create_client(addr).await;

    let request = tonic::Request::new(GenerateKeyRequest {
        namespace: "test".to_string(),
        key_type: KeyType::KeyTypeRsa2048 as i32,
        policy: Some(KeyUsagePolicy {
            allowed_usages: vec![],
            exportable: false,
            max_uses: 0,
            expiry_time: 0,
            allowed_namespaces: vec![],
        }),
        metadata: std::collections::HashMap::new(),
    });

    let response = client.generate_key(request).await;
    assert!(response.is_err());

    let err = response.unwrap_err();
    assert_eq!(err.code(), tonic::Code::Unauthenticated);
}

