async fn test_list_keys_without_auth() {
    let addr = setup_test_server().await;
    let mut client = create_client(addr).await;

    let request = tonic::Request::new(ListKeysRequest {
        namespace: "test".to_string(),
        page_size: 10,
        page_token: String::new(),
        filter_state: KeyState::KeyStateUnspecified as i32,
    });

    let response = client.list_keys(request).await;
    assert!(response.is_err());

    let err = response.unwrap_err();
    assert_eq!(err.code(), tonic::Code::Unauthenticated);
}

