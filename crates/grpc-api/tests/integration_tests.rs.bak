}

#[tokio::test]
async fn test_middleware_metrics() {
    use grpc_api::middleware::metrics::MetricsCollector;

    let collector = MetricsCollector::new();

    let metrics1 = collector.record_request();
    metrics1.finish_success();

    let stats = collector.get_stats();
    assert_eq!(stats.total_requests, 1);
    assert_eq!(stats.successful_requests, 1);
    assert_eq!(stats.failed_requests, 0);

    let metrics2 = collector.record_request();
    metrics2.finish_error(tonic::Code::Internal);

    let stats = collector.get_stats();
    assert_eq!(stats.total_requests, 2);
    assert_eq!(stats.successful_requests, 1);
    assert_eq!(stats.failed_requests, 1);
}

#[tokio::test]
async fn test_error_conversions() {
    use grpc_api::error::ApiError;

    let error = ApiError::KeyNotFound("test-key".to_string());
    let status: tonic::Status = error.into();
    assert_eq!(status.code(), tonic::Code::NotFound);

    let error = ApiError::AuthenticationFailed("invalid token".to_string());
    let status: tonic::Status = error.into();
    assert_eq!(status.code(), tonic::Code::Unauthenticated);

    let error = ApiError::AuthorizationFailed("insufficient permissions".to_string());
    let status: tonic::Status = error.into();
    assert_eq!(status.code(), tonic::Code::PermissionDenied);

    let error = ApiError::InvalidRequest("bad request".to_string());
    let status: tonic::Status = error.into();
    assert_eq!(status.code(), tonic::Code::InvalidArgument);

    let error = ApiError::RateLimitExceeded;
    let status: tonic::Status = error.into();
    assert_eq!(status.code(), tonic::Code::ResourceExhausted);
}
